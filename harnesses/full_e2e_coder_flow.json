{
  "harness_name": "full_e2e_coder_flow",
  "description": "Quy trình Toàn diện: Phân tích, Code, Kiểm duyệt Cú pháp, Unit Test, và KHỞI CHẠY APP THỰC TẾ ĐỂ CLICK TEST UI.",
  "initial_node": "planner",
  "state_schema": {
    "task": "",
    "target_file": "",
    "test_file": "",
    "pending_code": "",
    "errors": [],
    "lint_warnings": [],
    "retry_count": 0,
    "next_node": ""
  },
  "nodes": {
    "planner": {
      "type": "agent",
      "system_prompt": "Phân tích yêu cầu và định vị file cần sửa.",
      "tools": [
        "find_files",
        "find_content",
        "list_directory",
        "read_file_lines",
        "read_multiple_files",
        "read_file",
        "debug_desktop_app",
        "dynamic_browser_controller",
        "web_markdown_reader",
        "change_active_workspace",
        "replace_multiple_files_safe",
        "get_os_context",
        "capture_system_screenshot",
        "stop_terminal_process",
        "execute_terminal_command",
        "workflow_brainstorming"
      ],
      "model_mode": "fast",
      "include_global_prompt": true,
      "next": "coder"
    },
    "coder": {
      "type": "agent",
      "system_prompt": "Lập trình logic đáp ứng yêu cầu mới.",
      "tools": [
        "read_file",
        "write_file",
        "replace_content_safe",
        "execute_terminal_command",
        "read_multiple_files",
        "read_file_lines",
        "debug_desktop_app",
        "dynamic_browser_controller",
        "find_content",
        "list_directory",
        "find_files",
        "change_active_workspace",
        "replace_multiple_files_safe",
        "capture_system_screenshot",
        "stop_terminal_process",
        "get_os_context",
        "workflow_agent_browser",
        "workflow_code_review_expert",
        "workflow_gws_sheets_read",
        "workflow_gws_sheets",
        "workflow_gws_drive"
      ],
      "model_mode": "fast",
      "include_global_prompt": true,
      "next": "validator"
    },
    "validator": {
      "type": "validator",
      "validation_rule": "syntax_only",
      "target_file_key": "target_file",
      "next_on_success": "unit_tester",
      "next_on_failure": "healer"
    },
    "unit_tester": {
      "type": "agent",
      "system_prompt": "Chạy các bài Unit test. Bắt buộc trả về json {'errors': []} hoặc danh sách lỗi.",
      "tools": [
        "run_automated_tests",
        "run_advanced_tests"
      ],
      "model_mode": "fast",
      "include_global_prompt": true
    },
    "e2e_tester": {
      "type": "agent",
      "system_prompt": "Khởi chạy app ngầm, sau đó dùng công cụ điều khiển (Browser/Desktop) để bấm click thử tính năng. Tắt app khi xong. Trả về JSON {'errors': []} hoặc chứa lỗi.",
      "tools": [
        "execute_terminal_command",
        "stop_terminal_process",
        "dynamic_browser_controller",
        "debug_desktop_app"
      ],
      "model_mode": "thinking",
      "include_global_prompt": true
    },
    "healer": {
      "type": "agent",
      "system_prompt": "Khắc phục lỗi biên dịch, lỗi Unit Test, hoặc lỗi Runtime UI do tester trả về.",
      "tools": [
        "read_file",
        "replace_content_safe",
        "execute_terminal_command"
      ],
      "model_mode": "thinking",
      "include_global_prompt": true,
      "next": "validator"
    }
  },
  "edges": [
    {
      "from": "planner",
      "to": "coder"
    },
    {
      "from": "coder",
      "to": "validator"
    },
    {
      "from": "healer",
      "to": "validator"
    }
  ],
  "conditional_edges": [
    {
      "from": "validator",
      "condition_type": "state_check",
      "state_key": "errors",
      "router": {
        "is_empty": "unit_tester",
        "is_not_empty": "healer"
      }
    },
    {
      "from": "unit_tester",
      "condition_type": "state_check",
      "state_key": "errors",
      "router": {
        "is_empty": "e2e_tester",
        "is_not_empty": "healer"
      }
    },
    {
      "from": "e2e_tester",
      "condition_type": "state_check",
      "state_key": "errors",
      "router": {
        "is_empty": "end",
        "is_not_empty": "healer"
      }
    }
  ]
}