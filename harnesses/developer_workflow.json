{
  "harness_name": "developer_workflow",
  "description": "Stateful 5-phase software development graph",
  "initial_node": "planner",
  "state_schema": {
    "task": "",
    "target_file": "",
    "pending_code": "",
    "errors": [],
    "retry_count": 0,
    "next_node": ""
  },
  "nodes": {
    "planner": {
      "type": "agent",
      "system_prompt": "Bạn là Lead Architect. Đọc yêu cầu: '${state.task}' và tóm tắt thành kịch bản sửa đổi cho file: '${state.target_file}'. Chỉ ra đoạn code cần thay đổi.",
      "tools": [
        "read_file",
        "find_content"
      ],
      "model_mode": "fast",
      "next": "coder"
    },
    "coder": {
      "type": "agent",
      "system_prompt": "Bạn là Senior Developer. Nhận kế hoạch sau:\n${state.last_output}\n\nHãy viết code hoàn chỉnh để ghi đè hoặc thay thế nội dung vào file: '${state.target_file}'. Sử dụng tool 'replace_content_safe' hoặc 'write_file'.",
      "tools": [
        "replace_content_safe",
        "write_file",
        "execute_terminal_command"
      ],
      "model_mode": "fast",
      "next": "validator"
    },
    "validator": {
      "type": "validator",
      "validation_rule": "syntax_only",
      "target_file_key": "target_file",
      "next_on_success": "end",
      "next_on_failure": "healer"
    },
    "healer": {
      "type": "agent",
      "system_prompt": "Bạn là chuyên viên sửa lỗi biên dịch. File '${state.target_file}' gặp lỗi sau:\n${state.errors}\n\nHãy viết lại đoạn mã sửa lỗi tối ưu.",
      "tools": [
        "replace_content_safe",
        "read_file_lines"
      ],
      "model_mode": "thinking",
      "next": "coder"
    }
  },
  "edges": [
    {
      "from": "planner",
      "to": "coder"
    },
    {
      "from": "coder",
      "to": "validator"
    }
  ],
  "conditional_edges": [
    {
      "from": "validator",
      "condition_type": "state_check",
      "state_key": "errors",
      "router": {
        "is_empty": "end",
        "is_not_empty": "healer"
      }
    }
  ]
}