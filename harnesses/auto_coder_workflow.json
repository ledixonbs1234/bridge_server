{
  "harness_name": "auto_coder_workflow",
  "description": "Quy trình tự động phân tích cấu trúc, viết mã nguồn, kiểm duyệt cú pháp và tự sửa lỗi",
  "initial_node": "planner",
  "state_schema": {
    "task": "",
    "target_file": "",
    "pending_code": "",
    "errors": [],
    "retry_count": 0,
    "next_node": ""
  },
  "nodes": {
    "planner": {
      "type": "agent",
      "system_prompt": "Bạn là Kỹ sư Phân tích Mã nguồn (Software Architect Planner).\nNhiệm vụ của bạn là phân tích yêu cầu lập trình từ người dùng: \"${state.task}\".\nSử dụng các công cụ tìm kiếm tệp tin để định vị chính xác vị trí cần chỉnh sửa trong thư mục làm việc hiện hành.\nKhi đã tìm thấy tệp mục tiêu, hãy bàn giao tệp đó cho bước tiếp theo.",
      "tools": [
        "ask_questions_if_underspecified",
        "read_file",
        "read_multiple_files",
        "read_file_lines",
        "find_content",
        "list_directory",
        "find_files",
        "change_active_workspace",
        "get_os_context",
        "capture_system_screenshot"
      ],
      "model_mode": "fast",
      "include_global_prompt": true
    },
    "coder": {
      "type": "agent",
      "system_prompt": "Bạn là Trợ lý Lập trình viên (Senior Developer).\nNhiệm vụ của bạn là chỉnh sửa tệp tin dựa trên phân tích từ planner.\nQUY TẮC BẮT BUỘC: Bạn phải chạy công cụ 'read_file' để đọc nội dung tệp tin cần sửa trước khi áp dụng 'replace_content_safe' hoặc 'write_file'.\nSau khi chỉnh sửa thành công, mã nguồn sẽ tự động được gửi qua validator.",
      "tools": [
        "ask_questions_if_underspecified",
        "list_directory",
        "find_content",
        "find_files",
        "change_active_workspace",
        "replace_multiple_files_safe",
        "replace_content_safe",
        "write_file",
        "read_file",
        "read_multiple_files",
        "read_file_lines",
        "get_os_context",
        "execute_terminal_command",
        "stop_terminal_process",
        "capture_system_screenshot",
        "debug_desktop_app",
        "memorize_rule",
        "lsp_get_hover",
        "lsp_goto_definition",
        "lsp_find_references",
        "lsp_get_document_symbols",
        "lsp_rename_symbol",
        "lsp_get_code_actions",
        "lsp_apply_code_action"
      ],
      "model_mode": "fast",
      "include_global_prompt": true
    },
    "validator": {
      "type": "validator",
      "validation_rule": "syntax_only",
      "target_file_key": "target_file",
      "next_on_success": "end",
      "next_on_failure": "healer"
    },
    "healer": {
      "type": "agent",
      "system_prompt": "Bạn là Chuyên gia Sửa lỗi (Debugging Expert).\nValidator báo lỗi biên dịch/cú pháp sau trong quá trình kiểm duyệt: \"${state.errors}\".\nHãy đọc lại nội dung tệp tin lỗi bằng 'read_file', phân tích thông tin lỗi kỹ lưỡng, sửa lại mã nguồn sao cho hợp lệ và gửi lại trực tiếp cho validator để kiểm tra.",
      "tools": [
        "read_file",
        "read_multiple_files",
        "read_file_lines",
        "find_content",
        "list_directory",
        "find_files",
        "change_active_workspace",
        "replace_multiple_files_safe",
        "replace_content_safe",
        "write_file",
        "get_os_context",
        "execute_terminal_command",
        "stop_terminal_process",
        "capture_system_screenshot",
        "debug_desktop_app",
        "memorize_lesson",
        "lsp_get_hover",
        "lsp_goto_definition",
        "lsp_find_references",
        "lsp_rename_symbol",
        "lsp_get_document_symbols",
        "lsp_get_code_actions",
        "lsp_apply_code_action",
        "ask_questions_if_underspecified"
      ],
      "model_mode": "thinking",
      "include_global_prompt": true
    }
  },
  "edges": [
    {
      "from": "planner",
      "to": "coder"
    },
    {
      "from": "coder",
      "to": "validator"
    },
    {
      "from": "healer",
      "to": "validator"
    }
  ],
  "conditional_edges": [
    {
      "from": "validator",
      "condition_type": "state_check",
      "state_key": "errors",
      "router": {
        "is_empty": "end",
        "is_not_empty": "healer"
      }
    }
  ]
}